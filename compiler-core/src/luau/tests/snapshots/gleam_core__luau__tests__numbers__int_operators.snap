----- COMPILED LUAU
local _gleam = require("../gleam")

local function go()
  1 + 1
  5 - 1
  3 * 3
  _gleam.divideInt(5, 2)
  _gleam.remainderInt(5, 2)
  2 > 1
  2 < 1
  2 >= 1
  return 2 <= 1
end

return {
  go = go
}
