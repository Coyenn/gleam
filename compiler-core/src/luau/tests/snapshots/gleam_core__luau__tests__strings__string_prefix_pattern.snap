pub fn main(x) {
  case x {
    "hello" <> rest -> rest
    _ -> x
  }
}


----- COMPILED LUAU
local function main(x)
  return (function()
    local _subject_0 = x
    if string.sub(_subject_0, 1, 5) == "hello" then
    
      local rest = string.sub(_subject_0, 6)
      return rest
    elseif true then
    
      return x
    end
  end)()
