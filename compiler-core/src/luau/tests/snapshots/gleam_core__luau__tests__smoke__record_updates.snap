----- SOURCE CODE

pub type Person {
  Person(name: String, score: Int)
}

pub fn rename(person: Person) {
  Person(..person, name: "Lucy")
}

pub fn rename_result(person: Person) {
  Person(..{
    let x = person
    x
  }, name: "Nubi")
}


----- COMPILED LUAU
local Person = function(name, score)
  return {
    tag = "Person",
    name = name,
    score = score
  }
end

local function rename(person)
  return Person("Lucy", person.score)
end

local function rename_result(person)
  return (function()
    local _record = (function()
      local x = person
      return x
    end)()
    return Person("Nubi", _record.score)
  end)()
end

return {
  Person = Person,
  rename = rename,
  rename_result = rename_result
}
