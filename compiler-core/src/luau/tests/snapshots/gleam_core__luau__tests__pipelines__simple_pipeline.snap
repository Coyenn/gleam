----- SOURCE CODE

pub fn double(x) {
  x * 2
}

pub fn main() {
  1 |> double
}


----- COMPILED LUAU
local function double(x)
  return x * 2
end

local function main()
  return (function()
    local _pipe = 1
    return double(_pipe)
  end)()
end

return {
  double = double,
  main = main
}
