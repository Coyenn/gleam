----- SOURCE CODE

pub fn higher_order(f: fn(Int) -> Int) -> Int {
  f(1)
}

pub fn run() {
  higher_order(fn(x) { x + 1 })
}


----- COMPILED LUAU
local function higher_order(f)
  return f(1)
end

local function run()
  return higher_order(function(x)
    return x + 1
  end)
end

return {
  higher_order = higher_order,
  run = run
}
