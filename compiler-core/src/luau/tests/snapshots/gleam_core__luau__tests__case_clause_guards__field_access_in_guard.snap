pub fn main(pair: #(String, Int)) {
  case pair {
    #(n, _) if n == "Lucy" -> 1
    _ -> 0
  }
}


----- COMPILED LUAU
local _gleam = require("../gleam")

local function main(pair)
  return (function()
    local _subject_0 = pair
    if #_subject_0 == 2 then
    
      local n = _subject_0[1]
      if _gleam.isEqual(n, "Lucy") then
      return 1
      end
    end
    if true then
    
      return 0
    end
    end
  end)()
end

return {
  main = main
}
