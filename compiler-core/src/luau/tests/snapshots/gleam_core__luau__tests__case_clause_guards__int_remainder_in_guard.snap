pub fn main(x) {
  case x {
    n if n % 2 == 0 -> 0
    _ -> 1
  }
}


----- COMPILED LUAU
local _gleam = require("../gleam")

local function main(x)
  return (function()
    local _subject_0 = x
    if true then
    
      local n = _subject_0
      if _gleam.isEqual((_gleam.remainderInt(n, 2)), 0) then
      return 0
      end
    end
    if true then
    
      return 1
    end
    end
  end)()
end

return {
  main = main
