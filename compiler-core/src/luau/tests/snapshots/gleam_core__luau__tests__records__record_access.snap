----- SOURCE CODE

pub type Person {
  Person(name: String, score: Int)
}

pub fn main(person: Person) {
  person.name
}


----- COMPILED LUAU
local Person = function(name, score)
  return {
    tag = "Person",
    name = name,
    score = score
  }
end

local function main(person)
  return person.name
end

return {
  Person = Person,
  main = main
}
