--- GLEAM.TOML

name = "my_project"
version = "1.0.0"
target = "luau"

[luau]
runtime = "roblox"

[luau.roblox]
rojo_project = "default.project.json"
source_directory = "src"

[[luau.roblox.scripts]]
module = "game/server/main"
name = "Main"
container = "ServerScriptService"
run_context = "server"


